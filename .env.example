# =====================================================================
# ShaastraAI Environment Configuration
# =====================================================================

# Server Port (Defaults to 8000; AWS App Runner sets this automatically)
PORT=8000

# Google Gemini API Key (Recommended for high-fidelity multi-turn chat)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# AWS Bedrock & S3 Configuration (Optional - for pure AWS deployments)
# If running on AWS App Runner or EC2 with an IAM Task Role, credentials are auto-injected
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_20_char_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_40_char_aws_secret_access_key

# Amazon Bedrock Model ID (Supported: us.amazon.nova-lite-v1:0, anthropic.claude-3-haiku-20240307-v1:0)
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# S3 Bucket for RAG Storage (Optional - if loading FAISS vector index from S3)
S3_BUCKET_NAME=your-s3-bucket-name
